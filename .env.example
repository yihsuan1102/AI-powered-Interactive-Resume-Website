# AWS ECR Configuration
# Copy this file to .env and fill in your actual values

# Your 12-digit AWS Account ID (required)
AWS_ACCOUNT_ID=123456789012

# AWS Region where your ECR repository is located
AWS_REGION=us-east-1

# ECR Repository name
ECR_REPOSITORY=resume-website

# Docker image tag
IMAGE_TAG=latest

# Optional: AWS CLI Profile (if you use multiple AWS profiles)
# AWS_PROFILE=default

# Optional: AWS Access Keys (not recommended, use AWS CLI configure instead)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key