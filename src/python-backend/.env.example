# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Supabase Configuration (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Langfuse Configuration (for observability)
LANGFUSE_PUBLIC_KEY=pk_your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk_your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Resume Data Path (used in Lambda)
RESUME_JSON_PATH=/var/task/resume.json

# RAG Configuration - Only Supabase+LangChain mode is supported

# API Security
RAG_API_KEY=your-optional-api-key

# CORS Configuration
ALLOWED_ORIGINS=https://yihsuanliao.com,https://yourapp.vercel.app

# Development Settings
DEBUG=false